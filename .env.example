# Gemini API Credentials
GEMINI_API_KEY=your_gemini_api_key_here

# BizzHub Leave Management Integration
BIZZHUB_API_BASE_URL=http://localhost:3000/api
BIZZHUB_USER_EMAIL=your_bizzhub_login_email
BIZZHUB_PASSWORD=your_bizzhub_password

# Google OAuth Settings
GOOGLE_OAUTH_CREDENTIALS_PATH=./credentials.json

# Database Connection URLs
DATABASE_URL=sqlite:///./data/tasks.db
CHECKPOINTS_DATABASE_URL=sqlite:///./data/checkpoints.db

# Vector Store memory
CHROMA_PERSIST_DIR=./data/chroma_db

# Observability and Tracing
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langchain_api_key_here
LANGCHAIN_PROJECT=dailyops-agent

# Agent safety configuration
MAX_AGENT_ITERATIONS=6
